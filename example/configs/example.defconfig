CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=1024
CONFIG_LV_USE_TRANSLATION=y
CONFIG_LV_CACHE_DEF_SIZE=4096
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=4096
CONFIG_LV_USE_BIDI=y
CONFIG_LV_USE_ARABIC_PERSIAN_CHARS=y
